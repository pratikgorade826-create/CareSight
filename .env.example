# MongoDB Atlas Configuration (MongoDB is the ONLY application database)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=carecircle_db

# JWT Authentication
JWT_SECRET_KEY=caresight_super_secret_jwt_key_change_in_production_32bytes_min!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_SECRET_KEY=caresight_super_secret_refresh_jwt_key_change_in_production!
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=notifications@caresight.example.com
EMAIL_PASSWORD=your_email_password_or_app_password
EMAIL_FROM=CareSight Notifications <notifications@caresight.example.com>

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=caresight-production
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=

# Service Endpoints
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
